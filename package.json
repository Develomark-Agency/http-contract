{
  "name": "http-contract",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "version": "0.2.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "import": "./dist/internal.mjs"
    }
  },
  "type": "module",
  "private": true,
  "scripts": {
    "examples": "bun examples/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "tsdown",
    "prepublishOnly": "bun run typecheck && bun test --pass-with-no-tests && bun run build",
    "release": "bun scripts/release"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "better-result": "^3.0.1"
  }
}
