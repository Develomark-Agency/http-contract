{
  "name": "http-contract",
  "module": "index.ts",
  "version": "0.2.0",
  "exports": {
    ".": "./index.ts",
    "./errors": "./errors.ts",
    "./internal": "./internal.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "examples": "bun examples/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "tsdown",
    "prepublishOnly": "bun run typecheck && bun test --pass-with-no-tests && bun run build",
    "release": "bun scripts/release"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "better-result": "^3.0.1"
  }
}
